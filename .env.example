# ── Required ──────────────────────────────────────────────

# OpenRouter API key — powers all AI chat & summarization features
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── PostgreSQL (Supabase) ─────────────────────────────────

# Connection string for Prisma (pooler URL for Supabase)
DATABASE_URL=

# Direct URL for migrations and Prisma introspection
# (bypasses pgBouncer; required for schema changes)
DIRECT_URL=

# ── Optional ──────────────────────────────────────────────

# NewsData.io API key — used by the ingestion worker for Italian news
NEWS_API_KEY=
