# ── Required ──────────────────────────────────────────────

# OpenRouter API key — powers all AI chat & summarization features
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional server default provider/model. Personal browser settings are managed at /settings.
# AI_PROVIDER may be openrouter, openai, anthropic, or deepseek.
AI_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Encrypts personal provider cookies. Use a random value of at least 32 characters in production.
AI_SETTINGS_SECRET=
# Optional server keys for the other fixed providers (model IDs are entered at /settings).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_MODEL=
ANTHROPIC_MODEL=
DEEPSEEK_MODEL=

# ── PostgreSQL ────────────────────────────────────────────

# Connection string used by Prisma (via the pg driver adapter).
# When unset, the app still runs: the politics tracker falls back
# to in-memory storage and the cron ingestion is skipped.
DATABASE_URL=

# ── Cron & event ingestion ────────────────────────────────

# Bearer token protecting GET/POST /api/cron.
# The cron endpoint refuses all requests (500) while this is unset.
# External schedulers must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Bearer token protecting POST /api/politics-tracker (event ingestion).
# In production, POSTs are rejected while this is unset (fail closed);
# in development, POSTs are allowed without a token.
INGEST_API_KEY=

# NewsData.io API key — used by the ingestion pipeline for Italian news.
# (The legacy name NEWSDATA_API_KEY is also read as a fallback.)
NEWS_API_KEY=
